# Skills directory (internal, not part of this app)
/skills/
/.zscripts/
/examples/
/mini-services/
/tests/
/agent-ctx/

# Prisma / DB (we don't use it)
/prisma/
/db/

# User-private files (NOT to be committed)
# Note: upload/ folder used to be ignored, but user actually need some files from GitHub
# (e.g. wiktionary XML, kamus JSON). So we ignore specific patterns instead of whole /upload/.
/upload/Pasted*
/upload/Screenshot*
/upload/*-home.json
/upload/voicertool-research/
/upload/wiktionary/      # 86MB XML — too big for repo, user re-download from https://jv.wiktionary.org/wiki/Istimewa:Export
/download/    # generated split SRT outputs
/tool-results/ # debug output from Read tool

# Python bytecode cache (auto-generated, jangan commit)
__pycache__/
*.pyc
*.pyo

# Build artifacts that aren't needed in repo
Caddyfile

# Kamus Jawa JSON — TRACK di git supaya user bisa download dari GitHub (MacBook user)
# File: public/kamus-jawa-full.json (11MB, generated dari scripts/parse-wiktionary-jv.py)
# Compressed version: public/kamus-jawa-full.json.gz (~3MB)
# Web app load dari Supabase, bukan dari file ini. File ini untuk user edit lokal + re-import.

# Scraping / research artifacts (jangan commit ke repo)
astd-home.json
*-home.json
ref-*.json
pyvt-*.json
demucs-*.json
spleeter-*.json
thiojoe-*.json
videolingo-*.json
linly-*.json
krillin-*.json
softcat-*.json

